# ---------------------------------------------------------------------------
# Express API — copy to apps/api/.env for local development.
# Never commit real secrets. Placeholder values only in this file.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL (required). Development uses the bundled local database on 55432.
DATABASE_URL="postgresql://lms:lmsdev@127.0.0.1:55432/lms_dev?schema=public"

# Browser origin allowed to call the API directly (comma separated allowlist).
WEB_ORIGIN="http://localhost:3000"
# Public URL of the web app, used for certificate verification links and emails.
APP_PUBLIC_URL="http://localhost:3000"

# Session / cookie configuration
SESSION_COOKIE_NAME="lms_session"
CSRF_COOKIE_NAME="lms_csrf"
SESSION_TTL_HOURS=168
# Set true behind a TLS-terminating proxy in production.
COOKIE_SECURE=false
TRUST_PROXY=false

# Logging
LOG_LEVEL=info

# Private file storage: local (development) or s3 (production adapter required)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./var/storage"

# Optional SMTP for password-reset email. Without it, Super Admin issues
# one-time reset links through the audited staff action.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IT Institute <no-reply@example.edu>"

# Bootstrap (used only by `npm run seed:admin`; never a production default)
SEED_ADMIN_EMAIL="admin@example.edu"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Institute Administrator"
