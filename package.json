{
  "name": "it-institute-lms",
  "version": "1.0.0",
  "private": true,
  "description": "IT Institute LMS & Institute Operations Portal — Next.js PWA + Express API",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @lms/shared && npm run build -w @lms/api && npm run build -w @lms/web",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @lms/api\" \"npm run dev -w @lms/web\"",
    "dev:api": "npm run dev -w @lms/api",
    "dev:web": "npm run dev -w @lms/web",
    "db:start": "npm run db:start -w @lms/api",
    "db:migrate": "npm run db:migrate -w @lms/api",
    "db:seed": "npm run db:seed -w @lms/api",
    "db:reset": "npm run db:reset -w @lms/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @lms/api",
    "test:e2e": "npm run test:e2e -w @lms/web",
    "seed:admin": "npm run seed:admin -w @lms/api",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
